# HIF runtime
HIF_LOG_LEVEL=INFO
# Optional absolute path. Default: per-user data directory shared across projects.
HIF_DATABASE_PATH=

# Multi-provider starter catalog (checked 2026-11-28; providers rename models often).
# Leave HIF_MODEL_POOL empty to auto-activate starter models only for providers whose API key is set.
# Set an explicit comma-separated list to override the starter catalog.
# OpenAI: gpt-6-luna, gpt-6.2-sol, gpt-6.2-astra
# Anthropic: claude-haiku-5-5, claude-sonnet-5-5, claude-opus-5-5
# Gemini: gemini-3.5-flash-lite, gemini-3.8-flash, gemini-4-hydrogen, gemini-4-neon, gemini-4-carbon, gemini-4-argon
# Mistral: mistral-small-latest, mistral-large-latest
# DeepSeek: deepseek-flash, deepseek-v4-pro | Moonshot: kimi-k3.1-pro
# Alibaba DashScope/Qwen: qwen4-max, qwen3.8-flash
# xAI: grok-4.7 | Z.AI: glm-5.3 | MiniMax: MiniMax-M3.1-Flash
# Ordered chain example (first = primary, the rest = fallbacks; `hif models` shows it):
# HIF_MODEL_POOL=openai/gpt-6.2-astra,anthropic/claude-sonnet-5-5
HIF_MODEL_POOL=
# Defaults to the first active model unless explicitly set.
HIF_PLANNER_MODEL=

# Ordered specialist model preferences, JSON object.
# Leave empty to use HIF's task-specific starter preferences for active providers.
# Example: {"research":["gemini/gemini-3.8-flash"],"coding":["anthropic/claude-sonnet-5-5"]}
HIF_TASK_MODEL_PREFERENCES=

# HIF-measured token budgets within the rolling usage window.
# Reaching 80% of a configured model budget moves new tasks to the next eligible model.
# This does not measure consumer-subscription quota unless a provider offers a supported API.
HIF_USAGE_FALLBACK_THRESHOLD=0.80
HIF_USAGE_WINDOW_HOURS=168
HIF_DEFAULT_MODEL_TOKEN_BUDGET=250000
HIF_MODEL_TOKEN_BUDGETS={}

# Parallel execution and resource controls
# HIF_MAX_PARALLEL_TASKS is auto-sized from CPU/RAM when omitted; set explicitly to override.
# # Profiles: auto, browser, small, standard, server. Explicit HIF_* values override profile defaults.
HIF_EXECUTION_PROFILE=auto
HIF_MAX_PARALLEL_TASKS=4
HIF_MAX_PROVIDER_PARALLEL=3
HIF_MAX_LOCAL_THREADS=2
HIF_MAX_LOCAL_PROCESSES=1
HIF_LOCAL_TASK_MEMORY_MB=512
HIF_RESOURCE_AWARE=true
HIF_CPU_PRESSURE_THRESHOLD=85
HIF_MEMORY_PRESSURE_THRESHOLD=88
HIF_MIN_FREE_MEMORY_MB=1536

# Request and context limits
HIF_MAX_OUTPUT_TOKENS_PER_TASK=1800
HIF_REQUEST_TIMEOUT_SECONDS=120
HIF_MAX_CONTEXT_CHARS=16000

# Provider credentials: configure only what you use. Never commit real values.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=
XAI_API_KEY=
ZAI_API_KEY=
MINIMAX_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# Authenticated HTTP + Streamable HTTP MCP gateway
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HIF_GATEWAY_API_KEY=
HIF_GATEWAY_HOST=127.0.0.1
HIF_GATEWAY_PORT=8765
HIF_GATEWAY_RATE_LIMIT_PER_MINUTE=60
HIF_GATEWAY_MAX_REQUEST_BYTES=65536
# For remote DNS names, list exact Host values and wildcard-port values.
# Example: HIF_GATEWAY_ALLOWED_HOSTS=hif.example.com,hif.example.com:*
HIF_GATEWAY_ALLOWED_HOSTS=
# Optional browser Origin allowlist; MCP native clients often send no Origin.
HIF_GATEWAY_ALLOWED_ORIGINS=

# Required when binding HIF_GATEWAY_HOST to a non-loopback address.
# Prefer a TLS reverse proxy in production; otherwise set both files.
HIF_GATEWAY_TLS_CERTFILE=
HIF_GATEWAY_TLS_KEYFILE=

# Optional OAuth 2.1 / OIDC for remote MCP clients (ChatGPT, Copilot, etc.).
# HIF is an OAuth resource server; your identity provider handles user sign-in,
# authorization-code + PKCE, consent and token issuance.
# When configured, /mcp uses validated OIDC JWTs; REST /v1/* continues to use
# HIF_GATEWAY_API_KEY for private operator access.
HIF_GATEWAY_OAUTH_ISSUER_URL=
HIF_GATEWAY_OAUTH_RESOURCE_URL=
HIF_GATEWAY_OAUTH_AUDIENCE=
HIF_GATEWAY_OAUTH_JWKS_URL=
HIF_GATEWAY_OAUTH_REQUIRED_SCOPES=
HIF_GATEWAY_OAUTH_ALGORITHMS=RS256
# Optional: comma-separated Entra/OIDC client application IDs allowed to call HIF.
HIF_GATEWAY_OAUTH_ALLOWED_CLIENT_IDS=

# ---------------------------------------------------------------------------
# All providers HIF can call directly (see docs/PROVIDERS.md, or run `hif providers`).
# Set only the keys you use. Override any endpoint with HIF_<PREFIX>_BASE_URL.
# MISTRAL_API_KEY=
# SCW_SECRET_KEY=
# OVH_AI_ENDPOINTS_ACCESS_TOKEN=
# CEREBRAS_API_KEY=
# SAMBANOVA_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# DEEPINFRA_API_KEY=
# NVIDIA_API_KEY=
# HF_TOKEN=
# PERPLEXITY_API_KEY=
# COHERE_API_KEY=
# GITHUB_TOKEN=
# AZURE_OPENAI_API_KEY=
# HIF_AZURE_BASE_URL=https://<resource>.openai.azure.com/openai/v1
# Local runtimes (no key, data stays on your network):
# HIF_ENABLE_OLLAMA=true
# HIF_OLLAMA_BASE_URL=http://localhost:11434/v1
# HIF_VLLM_BASE_URL=http://localhost:8000/v1

# ---------------------------------------------------------------------------
# Agent spend circuit breaker (per HIF session, enforced before every model call).
# A tripped session stops with status "stopped_by_spend_guard" and never calls a provider again.
HIF_SESSION_MAX_TOKENS=500000
HIF_SESSION_MAX_CALLS=100
# Only enforced when providers report a cost (LiteLLM does; direct adapters report tokens).
HIF_SESSION_MAX_COST_USD=
# Identical (model, prompt) calls allowed before the loop detector trips.
HIF_SESSION_LOOP_REPEAT_LIMIT=3
