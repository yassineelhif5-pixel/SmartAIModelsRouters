# Copy to .env locally. Never commit real credentials.
HIF_LOG_LEVEL=INFO
HIF_STATE_PATH=.hif/state.sqlite3
HIF_MAX_PARALLEL_TASKS=4
HIF_DEFAULT_MAX_COST_USD=1.00

# Provider credentials (optional; configure only providers you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
