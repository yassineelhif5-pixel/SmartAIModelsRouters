# HIF runtime
HIF_LOG_LEVEL=INFO
# Optional absolute path. Default: per-user data directory shared across projects.
HIF_DATABASE_PATH=

# Add real provider model IDs supported by LiteLLM.
# Example format only: provider/model-id,provider/model-id
HIF_MODEL_POOL=
HIF_PLANNER_MODEL=

# Ordered specialist model preferences, JSON object.
# Example: {"research":["gemini/model-id"],"coding":["anthropic/model-id"]}
HIF_TASK_MODEL_PREFERENCES={}

# HIF-measured token budgets within the rolling usage window.
# Reaching 80% of a configured model budget moves new tasks to the next eligible model.
# This does not measure consumer-subscription quota unless a provider offers a supported API.
HIF_USAGE_FALLBACK_THRESHOLD=0.80
HIF_USAGE_WINDOW_HOURS=168
HIF_DEFAULT_MODEL_TOKEN_BUDGET=250000
HIF_MODEL_TOKEN_BUDGETS={}

# Parallel execution and resource controls
HIF_MAX_PARALLEL_TASKS=4
HIF_MAX_PROVIDER_PARALLEL=3
HIF_RESOURCE_AWARE=true
HIF_CPU_PRESSURE_THRESHOLD=85
HIF_MEMORY_PRESSURE_THRESHOLD=88
HIF_MIN_FREE_MEMORY_MB=1536

# Request and context limits
HIF_MAX_OUTPUT_TOKENS_PER_TASK=1800
HIF_REQUEST_TIMEOUT_SECONDS=120
HIF_MAX_CONTEXT_CHARS=16000

# Provider credentials: configure only what you use. Never commit real values.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Authenticated HTTP + Streamable HTTP MCP gateway
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HIF_GATEWAY_API_KEY=
HIF_GATEWAY_HOST=127.0.0.1
HIF_GATEWAY_PORT=8765
HIF_GATEWAY_RATE_LIMIT_PER_MINUTE=60
HIF_GATEWAY_MAX_REQUEST_BYTES=65536

# Required when binding HIF_GATEWAY_HOST to a non-loopback address.
# Prefer a TLS reverse proxy in production; otherwise set both files.
HIF_GATEWAY_TLS_CERTFILE=
HIF_GATEWAY_TLS_KEYFILE=
